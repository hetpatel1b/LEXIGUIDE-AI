# ==============================================================================
# LEXIGUIDE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "Understand. Compare. Act with confidence."
# ==============================================================================
# Security Notice:
# 1. Never commit real credentials or secrets to version control.
# 2. Duplicate this file as `.env.local` for local development.
# 3. Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser client.
# 4. Server secrets must never use the NEXT_PUBLIC_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# Client-Exposed Variables (Safe for browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="LexiGuide AI"
NEXT_PUBLIC_APP_TAGLINE="Understand. Compare. Act with confidence."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

