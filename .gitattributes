# Standardize line endings across Windows and POSIX systems
* text=auto eol=lf

# Code and text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binary files
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
